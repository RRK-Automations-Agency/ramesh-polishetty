# ============================================================
# RAMESH POLISETTY — Git Ignore Rules
# Protect sensitive files from being committed
# ============================================================

# Environment variables & config (contains API keys!)
.env
.env.local
.env.*.local
config/config.json
config.local.json
config.production.json

# Supabase
supabase/.temp/
supabase/.env

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

# Build output
dist/
build/

# Coverage
coverage/

# Supabase local dev
supabase/.branches/
supabase/.temp/

# Backup files
*.bak
*.backup
*.sql.bak

# Admin-uploaded photos (stored in Supabase, not git)
# Hero photos (hero-1.jpeg, hero-2.jpeg) ARE committed intentionally
photos/WhatsApp*
photos/IMG*
photos/DCIM*
photos/Snap*
photos/Screenshot*

# Vercel
.vercel/
